# Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número para SMS tradicional (formato E.164, ej: +14247244485)
TWILIO_PHONE_NUMBER=
# Número de WhatsApp de Twilio (sandbox: +14155238886, o tu número aprobado)
TWILIO_WHATSAPP_NUMBER=
# Canal por defecto: 'whatsapp' o 'sms'
CANAL_DEFAULT=whatsapp

# App
PORT=3000
NODE_ENV=development
